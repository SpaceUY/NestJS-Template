doctype html
html
  head
    style.
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        background-color: #4a90e2;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 5px;
      }
      .content {
        padding: 20px;
        background-color: #f9f9f9;
        border-radius: 5px;
        margin-top: 20px;
      }
      .footer {
        text-align: center;
        margin-top: 20px;
        font-size: 12px;
        color: #666;
      }
  body
    .header
      h1 New spaceship registered
    .content
      p A new spaceship has just been registered:
      p
        strong Name: #{name}
      p
        strong Fleet: #{fleet}
    .footer
      p This is an automated message, please do not reply to this email.
