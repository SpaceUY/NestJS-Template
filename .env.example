# Every key the code actually reads, grouped by the config scope that reads it.
# Required means the app refuses to boot without it.

# --- App (src/app.scope.ts) ---
NODE_ENV=DEV                  # DEV | TEST | PROD
PORT=5000
SELF_URL=http://localhost:5000
# Comma-separated allowlist. Required when NODE_ENV=PROD, and a wildcard is
# rejected there; '*' is the default everywhere else.
CORS_ORIGINS=*

# --- Auth / JWT (src/auth/config/jwt.scope.ts) ---
# REQUIRED. No default — the app will not start without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_IGNORE_EXPIRATION=false

# --- Database (src/database/config/database.scope.ts) ---
# Either DATABASE_URL on its own, or the full DB_* set. The factory prefers
# the URL and throws at startup if neither form is complete.
DATABASE_URL="postgresql://username:password@localhost:5432/databaseName?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=username
DB_PASS=password
DB_NAME=databaseName
DB_SYNCHRONIZE=false          # local development only — keep false elsewhere
DB_LOGGING=true

# --- Google OAuth (src/auth/google/config/google.scope.ts) ---
# CLIENT_ID, CLIENT_SECRET and AUDIENCE are required when ENABLED=true.
GOOGLE_OAUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_OAUTH_AUDIENCE=GOOGLE_OAUTH_AUDIENCE
GOOGLE_OAUTH_CALLBACK_URL=

# --- Auth0 (src/auth/auth0/config/auth0.scope.ts) ---
# DOMAIN and AUDIENCE are required when ENABLED=true.
AUTH0_ENABLED=true
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=AUTH0_AUDIENCE
AUTH0_ISSUER=

# --- Email (src/email/config/email.scope.ts) ---
# CONSOLE logs the message instead of sending it.
EMAIL_ADAPTER=CONSOLE         # AWS_SES | SENDGRID | RESEND | CONSOLE
EMAIL_FROM=from@email.com
SENDGRID_API_KEY=SG.SENDGRID_API_KEY
RESEND_API_KEY=
RESEND_EMAIL_FROM=
AWS_SES_REGION=

# --- Cloud storage, S3 (src/cloud-storage/s3-adapter/config/s3.scope.ts) ---
AWS_S3_BUCKET_NAME=AWS_S3_BUCKET_NAME
AWS_REGION=us-east-1
AWS_ACCESS_KEY=AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_S3_EXPIRES_IN_SECONDS=3600

# --- Push notifications, Expo (src/push-notification/expo-adapter/config/expo.scope.ts) ---
EXPO_ACCESS_TOKEN=

# --- Redis: cache adapter and the BullMQ queue adapter (src/redis.scope.ts) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ queue adapter (src/queues/rabbitmq-adapter/config/rabbitmq.scope.ts) ---
# The adapter ships complete but unwired; only BullMQ is registered today.
RABBITMQ_URL=amqp://localhost:5672

# --- Analytics (src/analytics/config/analytics.scope.ts) ---
# CONSOLE logs events instead of sending them. POSTHOG requires POSTHOG_API_KEY.
ANALYTICS_ADAPTER=CONSOLE     # POSTHOG | CONSOLE
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- OpenTelemetry (src/common/observability/telemetry/otel-env.ts) ---
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable tracing entirely.
# The local default points at the Jaeger container from docker-compose.yml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=nestjs-template
