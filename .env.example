# =============================================================================
# Copy to .env and fill in: `cp .env.example .env`
#
# Every key is grouped under the module that reads it, and each block names the
# config scope file that reads it. The grouping is also a contract: no scope may
# read a key that is missing here, and this file may not declare a key no scope
# reads (src/config-provider/CLAUDE.md, rule 9). Today that is 51 keys on both
# sides.
#
# READ THIS FIRST — a blank value is a value, not an omission.
# `KEY=` hands the scope an empty string, and Joi rejects an empty string for
# every key except the eight marked `blank ok` below. To leave something unset,
# comment the line out; do not blank it. That is why the optional blocks here
# ship commented rather than empty, and why uncommenting one without filling in
# a value fails loudly at boot instead of running on junk.
#
# As it ships, this file boots against `docker compose up -d` as soon as you set
# JWT_SECRET — the one key deliberately left blank, so the app refuses to start
# until you choose a secret rather than signing tokens with a shared constant.
# =============================================================================


# =============================================================================
# CORE — read on every boot
# =============================================================================

# --- App (src/app.scope.ts) ---
NODE_ENV=DEV                    # DEV | TEST | PROD
PORT=5000
SELF_URL=http://localhost:5000
# Comma-separated allowlist. Required when NODE_ENV=PROD, where a wildcard is
# rejected; '*' is the default everywhere else.
CORS_ORIGINS=*
# Publishes the API docs at /api. Defaults to false when NODE_ENV=PROD and true
# everywhere else, so leaving it unset is the safe choice — which is why it
# ships commented out. Uncomment it only to serve docs from a prod-like
# environment, and remember that a copy of this file carrying
# SWAGGER_ENABLED=true into production publishes the whole API surface.
# SWAGGER_ENABLED=true
# Express's `trust proxy` setting — what req.ip, req.protocol and secure-cookie
# handling are computed from. Off by default: an instance reached directly on
# its own elastic IP must keep seeing the real client IP. Behind a load
# balancer or reverse proxy, set the hop count to trust ('1' for a single ALB)
# or a specific address/CIDR list.
# TRUST_PROXY=1

# --- Auth / JWT (src/auth/config/jwt.scope.ts) ---
# REQUIRED, and the only key this file ships blank on purpose: with no value the
# app refuses to boot. The other two have defaults.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_IGNORE_EXPIRATION=false

# --- Database (src/database/config/database.scope.ts) ---
# Either DATABASE_URL on its own, or all five DB_* connection keys. The URL wins
# when both are present, so the discrete set ships commented out — uncomment it
# and comment the URL if you prefer it that way. With neither form complete the
# app throws at startup (src/database/database.module.ts). The credentials below
# are the ones docker-compose.yml creates.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs-template
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=nestjs-template
DB_SYNCHRONIZE=false            # local development only — keep false elsewhere
DB_LOGGING=true


# =============================================================================
# AUTH PROVIDERS — both off by default, and independent of the JWT block above
# =============================================================================

# --- Google OAuth (src/auth/google/config/google.scope.ts) ---
# With ENABLED=false the strategy is never constructed and every /auth/google
# route answers 404. Turning it on makes CLIENT_ID, CLIENT_SECRET and AUDIENCE
# required: the app will not boot without them.
GOOGLE_OAUTH_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_AUDIENCE=
# Optional even when enabled — absent derives ${SELF_URL}/auth/google/callback.
# GOOGLE_OAUTH_CALLBACK_URL=

# --- Auth0 (src/auth/auth0/config/auth0.scope.ts) ---
# Same shape: off by default, DOMAIN and AUDIENCE required when ENABLED=true.
AUTH0_ENABLED=false
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=
# Optional even when enabled — absent derives https://${AUTH0_DOMAIN}/.
# AUTH0_ISSUER=


# =============================================================================
# INFRASTRUCTURE — the values below match docker-compose.yml
# =============================================================================

# --- Redis: cache adapter and BullMQ queue adapter (src/redis.scope.ts) ---
# Both are registered unconditionally in src/app.module.ts, so the app expects
# Redis to be reachable at runtime. Health keeps it separate from the database:
# GET /health turns 503 while Redis is down, GET /health/live stays 200.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                 # blank ok — the compose container has no password

# --- RabbitMQ queue adapter (src/queues/rabbitmq-adapter/config/rabbitmq.scope.ts) ---
# The scope is registered but the adapter is not: only BullMQ is wired today.
# The key stays here because switching broker is a two-registration edit — see
# src/queues/README.md.
RABBITMQ_URL=amqp://localhost:5672


# =============================================================================
# OUTBOUND SERVICES — all optional; each falls back to a console adapter or to
# doing nothing until you give it credentials
# =============================================================================

# --- Email (src/email/config/email.scope.ts) ---
# CONSOLE logs the message instead of sending it and requires nothing else —
# not even EMAIL_FROM. Selecting any other adapter makes EMAIL_FROM and that
# provider's credential REQUIRED: the app refuses to boot without them, and the
# error names the missing environment variable. These are the keys where blank
# is genuinely allowed, and they ship blank rather than with plausible
# placeholders — a placeholder passes validation and fails at the first send,
# which is exactly what the check exists to prevent.
EMAIL_ADAPTER=CONSOLE           # AWS_SES | SENDGRID | RESEND | CONSOLE
EMAIL_FROM=                     # blank ok — required with AWS_SES, SENDGRID, RESEND
SENDGRID_API_KEY=               # blank ok — required when EMAIL_ADAPTER=SENDGRID
RESEND_API_KEY=                 # blank ok — required when EMAIL_ADAPTER=RESEND
RESEND_EMAIL_FROM=              # blank ok — Resend-only override of EMAIL_FROM
# blank ok — required when EMAIL_ADAPTER=AWS_SES, together with AWS_ACCESS_KEY
# and AWS_SECRET_ACCESS_KEY from the S3 block below: the SES adapter reads those
# same two keys and builds its client with an explicit credentials object, so it
# never falls back to the ambient AWS chain.
AWS_SES_REGION=

# --- Cloud storage, S3 (src/cloud-storage/s3-adapter/config/s3.scope.ts) ---
# Optional, and the whole block ships commented. Every field defaults to an
# empty string and the adapter only fails when you actually call it.
# Blank is NOT the same as absent here: `AWS_ACCESS_KEY=` fails this scope's
# validation even though the email scope above tolerates the same key blank.
# Comment it out or give it a value; do not leave it empty.
# AWS_S3_BUCKET_NAME=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_EXPIRES_IN_SECONDS=3600

# --- Push notifications, Expo (src/push-notification/expo-adapter/config/expo.scope.ts) ---
# Optional: Expo accepts unauthenticated sends, at a lower rate limit. Ships
# commented because a blank value is rejected — absent is fine, `=` is not.
# EXPO_ACCESS_TOKEN=

# --- Analytics (src/analytics/config/analytics.scope.ts) ---
# CONSOLE logs events instead of sending them. POSTHOG requires POSTHOG_API_KEY.
ANALYTICS_ADAPTER=CONSOLE       # POSTHOG | CONSOLE
POSTHOG_API_KEY=                # blank ok — required when ANALYTICS_ADAPTER=POSTHOG
POSTHOG_HOST=https://us.i.posthog.com


# =============================================================================
# CROSS-CUTTING
# =============================================================================

# --- Rate limiting (src/rate-limit.scope.ts) ---
# Applies to every route except the health checks. All three have defaults;
# ttlMs/limit may not be set to 0, which would lock the API out or disable the
# guard silently — RATE_LIMIT_ENABLED is the explicit way to turn it off, e.g.
# behind something that already rate-limits, or when several instances behind
# a load balancer make the per-instance in-memory counter wrong.
RATE_LIMIT_TTL_MS=60000         # window length, minimum 1000
RATE_LIMIT_LIMIT=100            # requests per window per client, minimum 1
# RATE_LIMIT_ENABLED=false

# --- OpenTelemetry (src/common/observability/telemetry/otel-env.ts) ---
# Read from process.env directly — the one deliberate exception to T2 — because
# tracing.bootstrap.ts runs before Nest's DI container exists.
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable tracing entirely. The value
# below points at the Jaeger container in docker-compose.yml; its UI is on
# http://localhost:16686.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nestjs-template
# Comma-separated `key=value` pairs sent by the exporter. Ships commented
# because a blank value throws on the first line of main.ts, before Nest starts.
# OTEL_EXPORTER_OTLP_HEADERS=


# =============================================================================
# REFERENCE DOMAIN MODULE (src/spaceship) — delete this block with the module
# =============================================================================

# --- Notification recipients (src/spaceship/notification/config/notification-recipients.scope.ts) ---
# Comma-separated list of the employees emailed when a spaceship is created.
# Blank is valid and means "notify nobody": the background job then logs a
# warning and returns instead of failing, so an unconfigured template still
# boots and still serves POST /spaceships.
NOTIFICATION_EMPLOYEE_EMAILS=

# --- Spaceship list cache (src/spaceship/config/spaceship-cache.scope.ts) ---
# TTL of the cache-aside entry behind GET /spaceships, in seconds. Writes
# invalidate the key, so this only bounds staleness from outside the app.
SPACESHIP_LIST_CACHE_TTL_SECONDS=60
